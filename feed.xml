---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'es' }}">
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle type="html">{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/feed.xml' | absolute_url }}</id>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <email>{{ site.author.email }}</email>
  </author>

  {% for page in site.pages %}
    {% if page.title != blank and page.url != '/404.html' and page.url != '/feed.xml' and page.exclude_from_feed != true %}
      {% unless page.url contains '.xml' or page.url contains '.json' or page.url contains '.css' or page.url contains '.webmanifest' or page.url contains '/assets/' %}
  <entry>
    <title type="html">{{ page.title | xml_escape }}</title>
    <link href="{{ page.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ page.url | absolute_url }}</id>
    <updated>{{ page.date | default: site.time | date_to_xmlschema }}</updated>
    {% if page.description %}<summary type="html">{{ page.description | xml_escape }}</summary>{% endif %}
    <content type="html"><![CDATA[{{ page.content | strip_html | truncatewords: 100 | xml_escape }}]]></content>
  </entry>
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% for item in site.clases %}
  <entry>
    <title type="html">{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ item.url | absolute_url }}</id>
    <updated>{{ item.date | default: site.time | date_to_xmlschema }}</updated>
    {% if item.description %}<summary type="html">{{ item.description | xml_escape }}</summary>{% endif %}
    {% if item.image %}<image>{{ item.image | absolute_url }}</image>{% endif %}
    <content type="html"><![CDATA[{{ item.content | strip_html | truncatewords: 100 | xml_escape }}]]></content>
  </entry>
  {% endfor %}

  {% for item in site.instructores %}
  <entry>
    <title type="html">{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ item.url | absolute_url }}</id>
    <updated>{{ item.date | default: site.time | date_to_xmlschema }}</updated>
    {% if item.description %}<summary type="html">{{ item.description | xml_escape }}</summary>{% endif %}
    {% if item.image %}<image>{{ item.image | absolute_url }}</image>{% endif %}
    <content type="html"><![CDATA[{{ item.content | strip_html | truncatewords: 100 | xml_escape }}]]></content>
  </entry>
  {% endfor %}

  {% for item in site.eventos %}
  <entry>
    <title type="html">{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ item.url | absolute_url }}</id>
    <updated>{{ item.date | default: site.time | date_to_xmlschema }}</updated>
    {% if item.description %}<summary type="html">{{ item.description | xml_escape }}</summary>{% endif %}
    {% if item.image %}<image>{{ item.image | absolute_url }}</image>{% endif %}
    <content type="html"><![CDATA[{{ item.content | strip_html | truncatewords: 100 | xml_escape }}]]></content>
  </entry>
  {% endfor %}

</feed>
